[Unit]
Description=Z Chat web app (TanStack Start on Node)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=zchat
Group=zchat
WorkingDirectory=/srv/zchat/app
Environment=PORT=1298
Environment=HOST=0.0.0.0
Environment=NITRO_PORT=1298
Environment=NITRO_HOST=0.0.0.0
Environment=SUPABASE_URL=https://dwstivxwyqdogzgxnidm.supabase.co
Environment=SUPABASE_PUBLISHABLE_KEY=sb_publishable_1ToX7uWyKMM_cqFjdWpGmQ_tQak-JF3
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=NODE_ENV=production

# Sandbox: this process runs repository code, so it gets no access to the
# host's files, users, root, or system configuration.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=

ExecStart=/usr/bin/node /srv/zchat/app/.output/server/index.mjs
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
